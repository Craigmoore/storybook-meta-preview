{
  "name": "storybook-meta-preview",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "storybook:html": "storybook dev -c .storybook-html -p 6006 --host 0.0.0.0",
    "relay:html": "PORT=3333 node src/relay.js",
    "dev:html": "concurrently \"yarn relay:html\" \"yarn storybook:html\"",
    "build:html": "storybook build -c .storybook-html",

    "storybook:threejs-2d": "STORYBOOK_RELAY_PORT=3334 storybook dev -c .storybook-threejs-2d -p 6007 --host 0.0.0.0",
    "relay:threejs-2d": "PORT=3334 node src/relay.js",
    "dev:threejs-2d": "concurrently \"yarn relay:threejs-2d\" \"yarn storybook:threejs-2d\"",
    "build:threejs-2d": "storybook build -c .storybook-threejs-2d",

    "storybook:threejs-3d": "STORYBOOK_RELAY_PORT=3335 storybook dev -c .storybook-threejs-3d -p 6008 --host 0.0.0.0",
    "relay:threejs-3d": "PORT=3335 node src/relay.js",
    "dev:threejs-3d": "concurrently \"yarn relay:threejs-3d\" \"yarn storybook:threejs-3d\"",
    "build:threejs-3d": "storybook build -c .storybook-threejs-3d"
  },
  "dependencies": {
    "express": "^4.18.2",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/html-webpack5": "^8.6.18",
    "concurrently": "^9.0.0",
    "storybook": "^8.6.18"
  }
}
