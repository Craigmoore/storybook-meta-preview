{
  "name": "storybook-meta-preview",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "storybook:html": "storybook dev -c .storybook-html -p 6006 --host 0.0.0.0",
    "relay:html": "PORT=3333 node src/relay.js",
    "dev:html": "concurrently \"yarn relay:html\" \"yarn storybook:html\"",
    "build:html": "storybook build -c .storybook-html"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/html-webpack5": "^8.6.18",
    "concurrently": "^9.0.0",
    "storybook": "^8.6.18"
  }
}
